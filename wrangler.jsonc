{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rc522-server",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  }
}
