{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rc522-server",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_HUB",
        "class_name": "RfidRelayHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RfidRelayHub"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  }
}
